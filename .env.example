# ใส่ค่าชุดเดียวกันนี้ทั้งบน Vercel (webhook) และ Railway (worker)
# ในเครื่องตัวเอง: คัดลอกเป็น .env.local

# 1) LINE Developers > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 1.1) Channel ID (เลขในหน้า Basic settings) — ใส่แล้วระบบจะ "ต่ออายุ token ให้เอง"
#      token ของ LINE มีอายุ 30 วัน หมดแล้วบอทเงียบสนิททั้งที่เว็บกับฐานข้อมูลยังปกติ
#      ใส่ช่องนี้ = ออกใหม่เองตั้งแต่เหลือ 2 วัน ไม่ต้องมาต่อด้วยมืออีกเลย (ตัวเก่ายังใช้ได้จนหมดอายุ)
LINE_CHANNEL_ID=

# 2) openrouter.ai > Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# (ไม่ใส่ก็ได้) โมเดลอ่านสลิป — ต้องดูรูปได้ · ไม่ใส่ = ใช้ตัวเดียวกับ OPENROUTER_MODEL
#   สมองหลักอ่านรูปไม่ได้ (เช่น deepseek/deepseek-v4-flash) ต้องใส่ช่องนี้ เช่น google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=
OPENROUTER_STT_MODEL=openai/whisper-1

# 2.1) (ไม่ใส่ก็ได้) ถอดเสียงด้วย ElevenLabs Scribe — แม่นภาษาไทยกว่า Whisper
#      ไม่ใส่ = ใช้ Whisper ผ่าน OpenRouter key ข้างบน ไม่ต้องสมัครเพิ่ม
ELEVENLABS_API_KEY=

# 3) Neon — กดสร้างในหน้า Vercel > Storage (ไม่ต้องสมัคร neon.tech แยก)
#    ดึงลงมาใส่ไฟล์นี้ด้วย:  node scripts/push-env.mjs pull
DATABASE_URL=

# 4) LINE userId ของเจ้าของ (คนที่จะรับรายงานสรุปกลุ่ม)
#    ทักบอทว่า "ไอดี" แล้วมันจะตอบกลับมาให้
OWNER_USER_ID=

# 4.1) (โหมดฟรี) รหัสให้ Vercel cron ยิงเข้า /api/cron ได้ — สุ่มเอา ไม่ต้องจำ
#      ไม่ได้ใช้ Railway ก็ตั้งอันนี้แทน จะได้สรุปกลุ่มวันละครั้งตอนเช้า
CRON_SECRET=

# 5) รหัสเปิดหน้า /dashboard — ตั้งเองอะไรก็ได้ที่เดายาก
DASHBOARD_KEY=

# 6) (ไม่ใส่ก็ได้) ชื่อบอทที่โชว์บนหน้า /dashboard
BOT_NAME=

# 7) (ไม่ใส่ก็ได้) ทับบุคลิกใน lib/persona.js ด้วย env — แก้บุคลิกโดยไม่ต้อง deploy ใหม่
PERSONA=

# 8) (ไม่ใส่ก็ได้) DASHBOARD_PUBLIC=1 → เปิด /dashboard ให้ใครก็เข้าได้ ไม่ต้องมี ?key=
#    ⚠️ ข้อมูลลูกค้า/ยอดเงิน/สรุปกลุ่มจะเปิดสาธารณะทั้งหมด ตั้งใจแล้วค่อยเปิด
DASHBOARD_PUBLIC=

# 9) (ไม่ใส่ก็ได้) ทีม Vercel เป็น Pro เท่านั้น — ตั้ง CRON_FREQUENT=1 คู่กับการเปลี่ยน
#    schedule ใน vercel.json เป็น "*/10 * * * *" → ได้สรุปตาม report_hours (เช้า-เย็น)
#    + เตือนลูกค้าถามค้าง โดยไม่ต้องจ่าย Railway
CRON_FREQUENT=

# 10) (ไม่ใส่ก็ได้) REPLY_TO_ALL=1 → ตอบทุกคนที่แอด OA มา
#     ค่า default (ไม่ใส่) = ตอบเฉพาะ OWNER_USER_ID เท่านั้น — คนแปลกหน้าแอดมาแล้วทัก บอทจะเงียบ
#     กันคนอื่นมาใช้เครดิต OpenRouter ของเรา และกันเลขาส่วนตัวหลุดออกนอกวง
REPLY_TO_ALL=


# 11) (ไม่ใส่ก็ได้) URL ของเว็บตัวเอง ใช้แปะลิงก์กระดานท้ายรายงานสรุป
#     บน Vercel ไม่ต้องใส่ — ระบบอ่านจาก VERCEL_PROJECT_PRODUCTION_URL ให้เอง
DASHBOARD_URL=

# 12) (ไม่ใส่ก็ได้) จำบทสนทนากี่ข้อความล่าสุด — default 24 (ประมาณ 12 คู่ถาม-ตอบ)
#     เพิ่มแล้วจำได้ไกลขึ้น แต่จ่ายค่า token เพิ่มทุกข้อความ · ของที่ "จดไว้" ไม่นับ ไม่มีวันลืม
CHAT_MEMORY=

# 13) (ไม่ใส่ก็ได้) ปฏิทิน Google — เอา "ที่อยู่ลับในรูปแบบ iCal" มาใส่ แล้วถามเลขาได้ว่าวันนี้มีนัดอะไร
#     หาที่: Google Calendar > ตั้งค่าและแชร์ปฏิทิน > รวมปฏิทิน > ที่อยู่ลับในรูปแบบ iCal
#     ใส่หลายปฏิทินได้ คั่นด้วยจุลภาค · อ่านอย่างเดียว (สร้างนัดใหม่ไม่ได้)
#     ⚠️ ใครมีลิงก์นี้อ่านปฏิทินได้ทั้งใบ — ห้าม commit ห้ามส่งต่อ
CALENDAR_ICS_URL=

# 14) (ไม่ใส่ก็ได้) SILENT_JOIN=1 → เชิญเข้ากลุ่มแล้วไม่ทักทาย ไม่ประกาศตัว
#     ค่า default (ไม่ใส่) = ทักทายครั้งเดียวตอนเข้ากลุ่ม บอกว่ามีบอทอ่านข้อความอยู่
SILENT_JOIN=

# 14.1) (ไม่ใส่ก็ได้) GROUP_SILENT=1 → บอทไม่พูดในกลุ่มเลย เก็บข้อมูลเงียบ ๆ อย่างเดียว
#       เจ้าของพิมพ์ "เลขา ..." ในกลุ่ม คำตอบจะไปเข้าแชทส่วนตัวแทน (กินโควตา push 1 ข้อความ)
GROUP_SILENT=

# 15) (ไม่ใส่ก็ได้) ต่อ Google Calendar + Drive ด้วย Service Account — ไม่ต้อง OAuth ไม่มีวันหมดอายุ
#     1. console.cloud.google.com → สร้างโปรเจค → Service Accounts → สร้าง → Keys → Add key → JSON
#     2. ในโปรเจคนั้น เปิดใช้ "Google Calendar API" กับ "Google Drive API"
#     3. เอา JSON ทั้งก้อน (บรรทัดเดียว) ใส่ช่องนี้
#     4. แชร์ "เฉพาะ" ปฏิทิน/โฟลเดอร์ที่อยากให้เลขาเห็น ให้อีเมลของ service account
#        (แชร์เท่าไหร่เห็นเท่านั้น ไม่ได้เปิดบัญชี Google ทั้งใบ) · ตรวจด้วย node scripts/check.mjs google
GOOGLE_SERVICE_ACCOUNT=

# 15.1) ปฏิทินไหน — ใส่อีเมล Google ของตัวเอง (ปฏิทินหลัก) หรือ calendar id ที่เห็นในหน้าตั้งค่าปฏิทิน
GOOGLE_CALENDAR_ID=
